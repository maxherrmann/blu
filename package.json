{
	"name": "blutooth",
	"version": "5.0.2",
	"description": "The type-safe framework for interacting with Bluetooth Low Energy devices from the browser and Node.js.",
	"keywords": [
		"blu",
		"bluetooth",
		"bluetooth low energy",
		"web bluetooth",
		"typescript"
	],
	"license": "MIT",
	"homepage": "https://github.com/maxherrmann/blu#readme",
	"bugs": "https://github.com/maxherrmann/blu/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/maxherrmann/blu.git"
	},
	"author": {
		"name": "Max Herrmann",
		"email": "npm@max-herrmann.com",
		"url": "https://github.com/maxherrmann"
	},
	"funding": "https://github.com/sponsors/maxherrmann",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"exports": {
		".": {
			"node": {
				"types": "./dist/index.node.d.ts",
				"default": "./dist/index.node.js"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"format": "prettier --write .",
		"lint": "eslint . && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@tsconfig/recommended": "^1.0.14",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-tsdoc": "^0.5.4",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"publint": "^0.3.25",
		"tsdown": "^0.23.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vitest": "^5.1.1",
		"webbluetooth": "^7.1.1"
	},
	"dependencies": {
		"@types/web-bluetooth": "^0.0.22",
		"jaset": "^2.0.0",
		"zod": "^4.6.7"
	},
	"peerDependencies": {
		"webbluetooth": ">=3"
	},
	"peerDependenciesMeta": {
		"webbluetooth": {
			"optional": true
		}
	},
	"allowScripts": {
		"webbluetooth@3.7.0": true,
		"fsevents@2.3.3": true
	}
}
